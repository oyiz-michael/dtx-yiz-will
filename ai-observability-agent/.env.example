# AI Observability Agent environment — copy to .env for local development.
# In Kubernetes, these come from a ConfigMap (non-sensitive).
# Bedrock auth uses the standard AWS credential chain (env, ~/.aws/credentials, SSO).

# ---- Observability backends ----
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
GRAFANA_URL=http://localhost:3000

# ---- Amazon Bedrock (no API key needed — uses AWS creds via boto3) ----
AWS_REGION=eu-west-2
AWS_PROFILE=your-aws-profile    # optional: boto3 uses default profile if unset
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# ---- Grafana auth (choose one) ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_API_KEY=

# ---- Slack ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ---- Agent behaviour ----
QUERY_LOOKBACK_MINUTES=5
LOG_LEVEL=INFO
DRY_RUN=false
HTTP_TIMEOUT=10
