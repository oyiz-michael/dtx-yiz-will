# AI Observability Agent — copy to .env for local development.
# In Kubernetes, non-sensitive values come from the ConfigMap;
# secrets come from the Kubernetes Secret.

# ---- Observability backends (port-forward these for local dev) ----
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
GRAFANA_URL=http://localhost:3000

# ---- Anthropic API ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# ---- AWS (used by SNS/SES optional outputs) ----
AWS_REGION=us-east-1

# ---- Grafana auth (choose one) ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_API_KEY=

# ---- Slack (optional) ----
SLACK_WEBHOOK_URL=

# ---- SMS via SNS (optional) ----
SNS_PHONE_NUMBER=    # E.164 format, e.g. +15551234567

# ---- Agent behaviour ----
QUERY_LOOKBACK_MINUTES=5
LOG_LEVEL=INFO
DRY_RUN=false
HTTP_TIMEOUT=10
